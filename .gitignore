# ==============================================================================
# GlobeX Trade OS — Production Git Ignore Rules
# ==============================================================================

# ── Datasets & Large Data Files (Stored in datasets/) ─────────────────────────
datasets/
**/datasets/
*.parquet
*.parquet.gzip
*.csv.gz
*.tar.gz
*.zip
*.h5
*.hdf5
*.pkl
*.pt
*.pth
*.onnx

# Allow small seed fixtures in frontend/src/data and backend seeds
!frontend/src/data/*.json
!backend/brain/data/final_csv/*.csv

# ── Large Model Checkpoints & Serialized Binaries ─────────────────────────────
# Note: Lightweight metadata & scalers (<500KB) can be tracked, large binaries excluded
*.joblib
*.bin
*.model

# ── Logs & Runtime Artefacts ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Node & Package Manager Dependencies ───────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local

# ── Python / Virtualenv / Pytest Cache ────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Frontend & Vite ───────────────────────────────────────────────────────────
.vite/
**/.vite/
coverage/

# ── Hardhat & Smart Contracts ─────────────────────────────────────────────────
artifacts/
**/artifacts/
cache/
**/cache/
typechain-types/
**/typechain-types/

# ── IDEs, OS & Editor Artifacts ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── AI Agents & Temporary Traces ──────────────────────────────────────────────
.agents/
.claude/
.system_generated/
