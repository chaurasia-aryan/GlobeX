# UN Comtrade API v1 Subscription Key (Required for high-volume automated requests; public preview works with rate limits)
COMTRADE_API_KEY=

# OpenSanctions API Key (Optional for bulk public files, required for live enterprise enrichment API)
OPENSANCTIONS_API_KEY=

# OpenCorporates API Key (Optional; pipeline skips gracefully if empty)
OPENCORPORATES_API_KEY=

# World Bank API Key (World Bank Indicators API is public and does not require a key by default)
WORLDBANK_API_KEY=

# Hugging Face Access Token (Optional for public OCR datasets FUNSD/SROIE/CORD; required for gated/private datasets)
HF_TOKEN=
